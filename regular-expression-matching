class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        memo = {}

        def dfs(i, j):
            if (i, j) in memo:
                return memo[(i, j)]
            if j == len(p):
                return i == len(s)

            # Check if current characters match
            match = i < len(s) and (s[i] == p[j] or p[j] == ".")

            # Handle the '*' wildcard
            if (j + 1) < len(p) and p[j + 1] == "*":
                # Decision: Skip '*' OR (Use '*' if match exists)
                res = dfs(i, j + 2) or (match and dfs(i + 1, j))
            else:
                # Normal character matching
                res = match and dfs(i + 1, j + 1)

            memo[(i, j)] = res
            return res

        return dfs(0, 0)
