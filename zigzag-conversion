class Solution:
    def convert(self, s: str, numRows: int) -> str:
        if numRows == 1 or numRows >= len(s):
            return s
        
        # Initialize rows
        rows = ["" for _ in range(numRows)]
        curr_row = 0
        direction = -1  # Will flip to 1 (down) on the first character
        
        for char in s:
            rows[curr_row] += char
            
            # Flip direction at boundaries
            if curr_row == 0 or curr_row == numRows - 1:
                direction *= -1
            
            curr_row += direction
            
        return "".join(rows)
