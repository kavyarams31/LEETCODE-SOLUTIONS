class Solution:
    def findMedianSortedArrays(self, nums1: list[int], nums2: list[int]) -> float:
        # Ensure nums1 is the smaller array
        if len(nums1) > len(nums2):
            nums1, nums2 = nums2, nums1
        
        m, n = len(nums1), len(nums2)
        low, high = 0, m
        
        while low <= high:
            partition1 = (low + high) // 2
            partition2 = (m + n + 1) // 2 - partition1
            
            # Boundary values (using -inf/inf for out-of-bounds)
            maxL1 = nums1[partition1-1] if partition1 > 0 else float('-inf')
            minR1 = nums1[partition1] if partition1 < m else float('inf')
            
            maxL2 = nums2[partition2-1] if partition2 > 0 else float('-inf')
            minR2 = nums2[partition2] if partition2 < n else float('inf')
            
            if maxL1 <= minR2 and maxL2 <= minR1:
                # Correct partition found
                if (m + n) % 2 == 1:
                    return max(maxL1, maxL2)
                return (max(maxL1, maxL2) + min(minR1, minR2)) / 2.0
            elif maxL1 > minR2:
                high = partition1 - 1
            else:
                low = partition1 + 1
