using System;
using System.Collections.Generic;

public class Solution {
    public IList<int> FindSubstring(string s, string[] words) {
        var ans = new List<int>();
        if (s == null || words == null || words.Length == 0) return ans;

        int m = s.Length, n = words.Length, k = words[0].Length;
        
        // Build the target word frequency map
        var cnt = new Dictionary<string, int>();
        foreach (var w in words) {
            cnt[w] = cnt.GetValueOrDefault(w, 0) + 1;
        }

        // Run the sliding window for each possible word-boundary offset
        for (int i = 0; i < k; ++i) {
            int l = i, r = i;
            var cnt1 = new Dictionary<string, int>();

            while (r + k <= m) {
                string t = s.Substring(r, k);
                r += k;

                // If the word doesn't exist in the input array, reset the window
                if (!cnt.ContainsKey(t)) {
                    cnt1.Clear();
                    l = r;
                    continue;
                }

                cnt1[t] = cnt1.GetValueOrDefault(t, 0) + 1;

                // Shrink window from the left if we have too many instances of word 't'
                while (cnt1[t] > cnt[t]) {
                    string w = s.Substring(l, k);
                    cnt1[w]--;
                    l += k;
                }

                // If window size matches the total length of all words, we found a match
                if (r - l == n * k) {
                    ans.Add(l);
                }
            }
        }

        return ans;
    }
}
