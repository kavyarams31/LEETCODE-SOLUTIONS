class Solution:
    def reverse(self, x: int) -> int:
        # Define 32-bit boundaries
        MIN, MAX = -2**31, 2**31 - 1
        
        # Handle sign
        sign = -1 if x < 0 else 1
        x = abs(x)
        
        res = 0
        while x:
            # Extract last digit
            pop = x % 10
            x //= 10
            
            # Build the reversed number
            res = (res * 10) + pop
            
        # Apply sign and check for overflow
        res *= sign
        if res < MIN or res > MAX:
            return 0
            
        return res
